# The stress corpus and its generated _work directory: megabytes of fixtures
# that exist to be read by the suite, never by the extension.
test/**
out-test/**
tsconfig.test.json
.tmp/**

# Older builds left in the folder and repository notes are not runtime files.
*.vsix
docs/**

# Native source workspaces and build caches are not extension runtime assets.
native/**

# Packaging recipe scripts and the Node reference backend: the installed extension runs on bin/dfv-table.
scripts/**
node_modules/@duckdb/**
