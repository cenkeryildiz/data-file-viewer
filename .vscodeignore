esbuild.js
tsconfig.json
.github/**
.serena/**
.gitignore
**/*.ts
**/*.map

# Bundled into dist/webview.js already — not needed at runtime in node_modules.
node_modules/@codemirror/**
node_modules/@lezer/**
node_modules/@marijn/**
